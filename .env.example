# Talon — environment variables (Netlify: Site settings -> Environment variables)
# Copy to .env for `netlify dev`. NEVER commit a real .env.

# --- Google Sheet (required for live mode) ---
# The Sheet must be shared "Anyone with the link can view".
# Grab the id from the Sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# Tab names, only change these if you renamed tabs in the Sheet.
SHEET_TAB_KPI=KPI
SHEET_TAB_TOP5=Daily Top-Five Progress
SHEET_TAB_REST=Rest Index
SHEET_TAB_META=Meta

# --- Access control (optional, recommended) ---
# If set, the board asks for this passphrase before it renders.
# Leave blank to rely on the secret /t/<random> URL (and/or Netlify's
# site-wide Visitor access password) instead.
TALON_PASSWORD=
